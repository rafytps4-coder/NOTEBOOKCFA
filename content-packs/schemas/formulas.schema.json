{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/formulas.schema.json",
  "title": "Helper formula bank pack",
  "description": "Static, shippable formula content. Per-user state (mastery, notes, review history) is NOT stored here; it lives in SwiftData keyed by formula id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packId",
    "helperId",
    "title",
    "curriculumVersion",
    "contentVersion",
    "license",
    "disclaimer",
    "formulas"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "helperId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "curriculumVersion": {
      "type": "string",
      "description": "Free-form label, e.g. '2027'. Lets several versions coexist."
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "Provenance statement. Must say the content is original or licensed."
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "description": "Shown in the Helper UI."
    },
    "kind": {
      "const": "formulas"
    },
    "formulas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/formula"
      }
    }
  },
  "$defs": {
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "topicId",
        "category",
        "equation",
        "variables",
        "purpose",
        "whenToUse",
        "workedExample",
        "commonMistakes",
        "difficulty",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "topicId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
          "description": "Must match a topic id in the topics pack."
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          },
          "description": "Must match concept ids in the topics pack."
        },
        "category": {
          "type": "string"
        },
        "equation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latex",
            "plain"
          ],
          "properties": {
            "latex": {
              "type": "string",
              "description": "Rendering form."
            },
            "plain": {
              "type": "string",
              "description": "Accessible/searchable form, also read by VoiceOver."
            }
          }
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "name"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "purpose": {
          "type": "string"
        },
        "whenToUse": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workedExample": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem",
            "steps",
            "answer"
          ],
          "properties": {
            "problem": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "answer": {
              "type": "string"
            }
          }
        },
        "relatedFormulaIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          }
        },
        "commonMistakes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "enum": [
            "foundational",
            "intermediate",
            "advanced"
          ]
        },
        "isCalculationHeavy": {
          "type": "boolean",
          "default": true
        },
        "source": {
          "enum": [
            "original"
          ],
          "description": "Only 'original' is allowed until a licensed source exists."
        }
      }
    }
  }
}